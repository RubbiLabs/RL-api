PORT=3000
NODE_ENV=development

# Local stack: docker compose -f docker-compose.dev.yml up db redis
# (host ports are configurable with POSTGRES_PORT / REDIS_URL below)
DATABASE_URL=postgresql://rubbi:rubbi@localhost:5432/rubbi
REDIS_URL=redis://localhost:6379

# Stellar network. Contract ids below are the public testnet deployment
# recorded in RL-smart-contracts/deployments/testnet.json (commit 2136695).
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
# Optional: defaults to the passphrase of STELLAR_NETWORK.
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
USDC_SAC_ID=CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA
VAULT_CONTRACT_ID=CBGARSQ7BY4345DNX76LWT4VXEHRRFJMNW46SCX7DRHBILL5V6RJN6KR
SUBSCRIPTIONS_CONTRACT_ID=CDWMLKAUMXHLSBOKKCK5A4ECUP2VIIHXAL7MVQ5TEFLE3QUXZRMDC3PC
PAYROLL_CONTRACT_ID=CB76PQ2MTILAQJAHLMTRHYDODX7H73YUCTVVKYO46ME3MK6WUTELDGYU

# Backend signing keys (S..., 56 chars). The all-zero seed below is a valid
# placeholder for local development and is rejected in production.
# The real keys live in the operator's secret store, never in the repo.
OPERATOR_SECRET=SAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAABSU2
KEEPER_SECRET=SAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAABSU2
SEP10_SIGNING_SECRET=SAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAABSU2
# Optional. When empty, card unloads wait in PENDING_TREASURY and are processed
# with scripts/process-pending-unloads.ts by an operator holding the treasury key.
TREASURY_SECRET=

# SEP-10
HOME_DOMAIN=localhost:3000
WEB_AUTH_DOMAIN=localhost:3000

# Indexer and keeper
INDEXER_POLL_INTERVAL_MS=5000
# Optional: first-run start ledger (defaults to the latest ledger).
INDEXER_START_LEDGER=
KEEPER_CRON=*/10 * * * *
KEEPER_HOLD_SECONDS=21600

# Card issuer: mock (default) or sudo. SUDO_* are required only for sudo.
CARD_ISSUER=mock
SUDO_API_KEY=
SUDO_BASE_URL=https://api.sudo.africa
SUDO_DEFAULT_CUSTOMER_ID=
# Webhook HMAC secret. Optional under mock (a fixed dev secret is used), required in production.
SUDO_WEBHOOK_SECRET=

JWT_SECRET=replace-with-at-least-32-char-secret
JWT_EXPIRES_IN=24h

# Browser origins allowed by CORS (comma-separated absolute URLs, exact match,
# no wildcard). Add the frontend's origin, e.g. http://localhost:3001 when the
# API itself runs on port 3000.
CORS_ORIGINS=http://localhost:3000
