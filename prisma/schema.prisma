generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A Rubbi user, identified by their Stellar account (G...). Stellar
/// addresses are case-sensitive and stored verbatim.
///
/// Two balances, both in USDC with 7 decimals:
/// - `walletBalance` mirrors the user's on-chain vault balance and is written
///   only by the chain indexer.
/// - `cardBalance` is the issuer-side card balance, moved by card loads and
///   unloads (operator-settled on-chain) and by card spend / refund webhooks.
model User {
  id             String   @id @default(uuid())
  stellarAddress String   @unique
  username       String?  @unique
  walletBalance  Decimal  @default(0) @db.Decimal(20, 7)
  cardBalance    Decimal  @default(0) @db.Decimal(20, 7)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  card             Card?
  deposits         Deposit[]
  transactions     Transaction[]
  subscriptions    Subscription[]
  payrollSchedules PayrollSchedule[]
  cardMovements    CardMovement[]
}

model Card {
  id          String     @id @default(uuid())
  userId      String     @unique
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// "MOCK" or "SUDO". The frontend shows a MOCK badge when it is "MOCK".
  issuer      String
  issuerId    String     @unique
  last4       String
  expiryMonth String
  expiryYear  String
  status      CardStatus @default(ACTIVE)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

/// A confirmed vault `deposit` event. `txHash` is the Stellar transaction hash
/// (64 hex characters); `amountRaw` is the i128 amount in stroops (10^-7).
model Deposit {
  id          String        @id @default(uuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  txHash      String
  eventId     String        @unique
  amountRaw   String
  amount      Decimal       @db.Decimal(20, 7)
  status      DepositStatus @default(CONFIRMED)
  ledger      Int
  confirmedAt DateTime?
  createdAt   DateTime      @default(now())

  @@index([userId, createdAt])
  @@index([txHash])
}

/// Ledger row. Every change to `walletBalance` or `cardBalance` creates one
/// row in the same database transaction; `amount` is the signed delta applied
/// to `account` and `balanceAfter` is that balance after the change.
model Transaction {
  id           String          @id @default(uuid())
  userId       String
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         TransactionType
  account      BalanceAccount
  amount       Decimal         @db.Decimal(20, 7)
  balanceAfter Decimal         @db.Decimal(20, 7)
  description  String
  metadata     Json?
  createdAt    DateTime        @default(now())

  @@index([userId, createdAt])
}

/// Card load / unload state machine. A load moves USDC from the user's vault
/// to the treasury (`settle_card_spend`) and then funds the card; an unload
/// defunds the card and moves USDC back (`credit_refund`). `reference` is the
/// on-chain idempotency key: sha256 of this row's id.
model CardMovement {
  id          String             @id @default(uuid())
  userId      String
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  direction   CardMoveDirection
  amount      Decimal            @db.Decimal(20, 7)
  reference   String             @unique
  status      CardMoveStatus     @default(PENDING)
  txHash      String?
  failureReason String?
  /// Set on the UNLOAD that returns the funds of a LOAD whose issuer funding
  /// failed after the on-chain settlement. It skips the card step.
  compensatesId String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  settledAt   DateTime?
  completedAt DateTime?

  @@index([userId, createdAt])
  @@index([status])
}

/// Mirror of an on-chain subscriptions `Plan`, written by the indexer.
model SubscriptionPlan {
  id        Int      @id
  merchant  String
  name      String
  amount    Decimal  @db.Decimal(20, 7)
  period    Int
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]
}

/// Mirror of an on-chain `Subscription`, written by the indexer. The
/// subscriber may not be a Rubbi user (then `userId` is null).
model Subscription {
  id             String    @id @default(uuid())
  onChainSubId   BigInt    @unique
  subscriber     String
  userId         String?
  user           User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  planId         Int
  plan           SubscriptionPlan @relation(fields: [planId], references: [id])
  status         SubStatus @default(ACTIVE)
  nextDueAt      DateTime
  lastChargedAt  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([subscriber])
  @@index([status, nextDueAt])
}

/// Mirror of an on-chain payroll `Schedule`, written by the indexer. The
/// label is read with `get_schedule` because the event does not carry it.
model PayrollSchedule {
  id              String         @id @default(uuid())
  onChainId       BigInt         @unique
  employer        String
  employerUserId  String?
  employerUser    User?          @relation(fields: [employerUserId], references: [id], onDelete: SetNull)
  recipient       String
  amount          Decimal        @db.Decimal(20, 7)
  period          Int
  label           String
  status          ScheduleStatus @default(ACTIVE)
  nextDueAt       DateTime
  lastDisbursedAt DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([employer])
  @@index([recipient])
  @@index([status, nextDueAt])
}

/// Position of the event indexer. One row (`id = "stellar"`).
model ChainCursor {
  id         String   @id
  cursor     String
  lastLedger Int
  updatedAt  DateTime @updatedAt
}

/// Every chain event the indexer has applied, so an event is never applied
/// twice (the row is written in the same transaction as the event's effects).
model ProcessedEvent {
  eventId     String   @id
  contractId  String
  type        String
  ledger      Int
  txHash      String
  processedAt DateTime @default(now())

  @@index([contractId, ledger])
}

/// A range of ledgers the indexer could not read because the RPC's retention
/// window had moved past the saved cursor. Backfill tooling starts here.
model ChainGap {
  id         String   @id @default(uuid())
  fromLedger Int
  toLedger   Int
  reason     String
  detectedAt DateTime @default(now())
  resolvedAt DateTime?
}

enum CardStatus {
  ACTIVE
  FROZEN
  TERMINATED
}

enum DepositStatus {
  PENDING
  CONFIRMED
  FAILED
}

enum BalanceAccount {
  WALLET
  CARD
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  CARD_LOAD
  CARD_UNLOAD
  CARD_SPEND_SETTLED
  SPEND
  REFUND
  SUBSCRIPTION_PAYMENT
  PAYROLL_FUNDED
  PAYROLL_DISBURSED
}

enum CardMoveDirection {
  LOAD
  UNLOAD
}

enum CardMoveStatus {
  PENDING
  SETTLED
  PENDING_TREASURY
  COMPLETED
  FAILED
}

enum SubStatus {
  ACTIVE
  PAUSED
  PAST_DUE
  CANCELLED
}

enum ScheduleStatus {
  ACTIVE
  PAUSED
  CANCELLED
}
